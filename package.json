{
  "name": "migration-factor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Migration Factor website. Business content sourced from the supplied report.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/server.mjs",
    "dev": "node scripts/build.mjs && node scripts/server.mjs",
    "next:dev": "npm --prefix nextjs-app run dev",
    "next:build": "npm --prefix nextjs-app run build",
    "next:start": "npm --prefix nextjs-app run start",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check scripts/server.mjs && npm run build && node --check dist/site.js && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "lighthouse": "^13.5.0"
  }
}
